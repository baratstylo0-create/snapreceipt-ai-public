{
  "name": "receipt-saas",
  "version": "0.1.0",
  "description": "SnapReceipt AI — Telegram bot OCR + expenses dashboard. Standalone, extracted from FrictionAI.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "setup-webhook": "node server.js --register-only",
    "setup-admin": "node setup/provision.js",
    "test": "node --test",
    "mobile:doctor": "npx cap doctor",
    "mobile:add:android": "npx cap add android",
    "mobile:sync": "npx cap sync android",
    "mobile:open:android": "npx cap open android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "resend": "^6.18.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1"
  }
}
