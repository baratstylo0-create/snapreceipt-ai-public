# ============================================================================
# Receipt Analyser SaaS — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ── Telegram ────────────────────────────────────────────────────────────────
# Create a new bot with @BotFather → /newbot → paste the token here.
BOT_TOKEN=
# BOT_USERNAME (optional): the bot's public @handle, used to build the clickable
# t.me/<bot>?start=<code> binding link in the dashboard. Leave BLANK — the server
# auto-detects it from the token via Telegram getMe at startup. Set it only to force a
# specific handle (auto-detection is skipped when this is non-empty).
BOT_USERNAME=

# ── Groq (vision OCR + LLM) ─────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
# GROQ_KEYS (optional, ADR-016 multi-key pool): comma-separated keys from several free
#   accounts, e.g. GROQ_KEYS=k1,k2,k3 — the system falls through to a fresh account's quota
#   on a 429 (~Nx daily ceiling at $0, same model/quality). ⚠️ When GROQ_KEYS is set it
#   SUPERSEDES GROQ_KEY — GROQ_KEY is then IGNORED (a stale value here is silently unused,
#   NOT added to the pool). Use one or the other. All keys are server-side-only secrets,
#   rotated per the ADR-015 launch gate. Leave GROQ_KEYS unset to use the single GROQ_KEY.
GROQ_KEY=
GROQ_KEYS=

# ── Supabase (your colleague's project) ─────────────────────────────────────
# SB_URL  = the project URL, e.g. https://abcdxyz.supabase.co  (NO /rest/v1)
# SB_KEY  = the SERVICE-ROLE key (Settings → API). Server-side only — never shipped to the browser.
SB_URL=
SB_KEY=

# ── Public URL (for automatic Telegram webhook registration) ────────────────
# The HTTPS URL where THIS server is reachable, e.g. https://receipts.yourdomain.com
# Leave blank to skip auto-registration and register the webhook manually (see README).
PUBLIC_URL=

# WEBHOOK_CERT_PATH: only needed on a SELF-SIGNED host (no real/CA-trusted cert yet).
# Path to the same .pem your reverse proxy (nginx) serves, e.g. /etc/nginx/ssl/receipt.pem.
# registerWebhook() then uploads it WITH setWebhook (multipart `certificate` field) —
# Telegram won't trust a self-signed host otherwise. Leave blank once you have a real
# cert (Let's Encrypt, Render, Fly, etc.) — the plain JSON registration path is used instead.
WEBHOOK_CERT_PATH=

# ── Security (optional but recommended) ─────────────────────────────────────
# WEBHOOK_SECRET   : random string; Telegram echoes it back so only Telegram can post to /webhook.
# DASHBOARD_TOKEN  : if set, the dashboard + /api/expenses (+ /receipt/:fileId) require this token.
#                    PRODUCTION MUST SET THIS. When NODE_ENV=production (or AUTH_REQUIRED=true)
#                    and this is unset, checkDash fails CLOSED — every gated route (including the
#                    receipt-image proxy) refuses the request with a 500 "server misconfigured"
#                    rather than silently letting it through. In dev, an unset token still falls
#                    back to the old permissive (no-op) behavior, but logs a console.warn on every
#                    unauthenticated request so it's never silently forgotten.
# AUTH_REQUIRED    : set to "true" to force the fail-closed behavior above outside NODE_ENV=production
#                    (e.g. a staging env). Not needed if NODE_ENV=production is already set.
# DASHBOARD_ORIGIN : the dashboard's own origin (e.g. https://receipts.yourdomain.com, no trailing
#                    slash/path). When set, token-gated routes reflect it as
#                    Access-Control-Allow-Origin instead of '*'. PRODUCTION SHOULD SET THIS — with
#                    a bearer token, '*' lets any origin call the API from a browser. Left unset,
#                    routes fall back to '*' so local dev keeps working without extra config.
# HSTS_ENABLED     : set to "false" ONLY on a deployment running a self-signed cert (e.g. a bare
#                    IP with no domain, so no CA-trusted cert via Let's Encrypt is possible yet).
#                    HSTS + a self-signed cert is a permanent-lockout combo (incident
#                    2026-07-17): once a browser accepts the cert once, it caches the HSTS policy
#                    and refuses to EVER show a cert-error bypass link again for that host until
#                    the policy is manually cleared (chrome://net-internals/#hsts) or max-age
#                    expires (180 days) — a normal page reload then hard-fails with no way
#                    through. Unset/anything else keeps the default-on behavior, which is what
#                    you want once the deployment has a real domain + trusted cert.
WEBHOOK_SECRET=
DASHBOARD_TOKEN=
AUTH_REQUIRED=
DASHBOARD_ORIGIN=
HSTS_ENABLED=
# CRED_ENC_KEY     : ADR-025 amendment (Owner-approved, 2026-07-11 QA round). Any secret string —
#                    encrypts branch-clerk passwords at rest (AES-256-GCM) so an admin can view one
#                    again later (lib/credCrypto.js). Login itself still checks the separate one-way
#                    scrypt hash, unaffected. LEAVE BLANK — the server auto-generates a key on first
#                    boot and persists it (see CRED_ENC_KEY_FILE) so recoverable passwords work with
#                    zero config. Set this explicitly only to control the key yourself. Rotating the
#                    key makes every EXISTING encrypted password unreadable (not the login itself) —
#                    reset affected branches' passwords after a rotation.
# CRED_ENC_KEY_FILE: where the auto-generated key is stored (default: .cred_key in the app root,
#                    gitignored, survives redeploys). Override to point at a persistent volume path.
CRED_ENC_KEY=
CRED_ENC_KEY_FILE=

# ── Observability: Sentry free tier (optional, one SnapReceipt AI project) ──
# Claude owns the real Sentry account/project setup and copies the DSN into the deployment.
# Leave SENTRY_DSN blank locally. When set, backend runtime errors are sent to Sentry after
# strict scrubbing: no request bodies, cookies, auth headers, receipt fields, OCR payloads,
# images, merchant details, amounts, emails, or user identifiers.
# SENTRY_ENABLED=false forces Sentry off even when a DSN exists.
# Keep traces at 0 on the free tier unless we deliberately sample a small production slice.
SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Rate limiting (P6 hardening — lib/ratelimit.js, per-IP fixed window) ────
# These are RUNAWAY backstops, not throttles — set generous so a busy legit user/company
# NEVER trips them; the Groq key pool (ADR-016) is the actual cost backstop. Raise freely.
# DASH_AUTH_RATE_MAX : requests/min per IP that FAIL auth before a 429 (valid-token traffic
#                      bypasses the limiter entirely — review A#1) — blunts DASHBOARD_TOKEN brute-force only.
# UPLOAD_RATE_MAX    : requests/min per IP to POST /api/upload (~10x a human's peak; caps a bug-loop).
# AGENT_RATE_MAX     : requests/min per IP to POST /api/agent (~6-12x a power-user's peak).
# WEBHOOK_RATE_MAX    (Barat's, see routes/webhook.js) : requests/min per IP to POST /webhook.
# READY_RATE_MAX     : requests/min per IP to GET /ready (#13 deep readiness probe; it touches the DB).
DASH_AUTH_RATE_MAX=60
UPLOAD_RATE_MAX=120
AGENT_RATE_MAX=120
READY_RATE_MAX=60

# ── App defaults ────────────────────────────────────────────────────────────
# ACCOUNT_ID       : scope key for v1 (one account). Keep 'default' unless you know why.
# DEFAULT_CURRENCY : used when a receipt doesn't show a currency (USD, AUD, MYR, EUR, GBP, …).
# DEFAULT_TAX_RATE : 0 for none, or e.g. 0.10 for 10% GST (used to split tax-inclusive totals).
# VISION_MODEL     : OpenRouter vision model id (see the Model routing section below).
# PORT             : HTTP port.
# ALLOWED_CHAT_IDS : optional comma-separated Telegram chat IDs allowed to use the bot.
#                    Empty/unset = open to anyone. Set it to lock the bot to known users.
ACCOUNT_ID=default
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0
ALLOWED_CHAT_IDS=

# ── Account capabilities (ADR-010) ──────────────────────────────────────────
# One codebase, capability flags. Default = personal (all business features OFF).
# ACCOUNT_TYPE=business flips the defaults on; individual CAP_* override either way.
# ACCOUNT_TYPE           : personal | business   (default personal)
# CAP_BUSINESS_PROFILE   : business-context categorization + personal-expense detection (#5/#6)
# CAP_CLAIMS_TAX         : surface reclaimable VAT/GST in reports/dashboard
# CAP_BANK_RECONCILIATION: receipt <-> bank-statement matching
# CAP_MULTI_USER         : roles + admin approve/reject queue
# BUSINESS_TYPE          : e.g. "restaurant" — context for the personal-vs-business check
ACCOUNT_TYPE=personal
# CAP_BUSINESS_PROFILE=
# CAP_CLAIMS_TAX=
# CAP_BANK_RECONCILIATION=
# CAP_MULTI_USER=

# SESSION_TTL_MS   : how long a signed-in dashboard session lasts before requiring a fresh
#                    login (CAP_MULTI_USER mode — lib/auth.js mintSession/lookupSession).
#                    Default 43200000 (12h) if unset. Security/convenience tradeoff: shorter
#                    bounds the exposure window if a device is lost/stolen/shared; longer means
#                    fewer re-logins. 604800000 = 7 days, 2592000000 = 30 days.
# SESSION_TTL_MS=
# BUSINESS_TYPE=
PORT=3001

# ── Model routing (Vertical AI — see docs/ARCHITECTURE.md §3.5) ──────────────
# See docs/DECISIONS.md ADR-007 (Groq scout decommission) and the 2026-07-21 follow-up
# (vision moved to OpenRouter) for full status + rationale.
#
# VISION_MODEL      : meta-llama/llama-4-scout — served via OpenRouter (lib/openrouter.js),
#                     NOT Groq. Groq decommissioned llama-4-scout 2026-07-17; the forced
#                     replacement (qwen/qwen3.6-27b on Groq) proved unreliable enough on real
#                     receipts that OCR moved providers entirely rather than keep tuning around
#                     it. OpenRouter's slug is 'meta-llama/llama-4-scout' — shorter than Groq's
#                     'meta-llama/llama-4-scout-17b-16e-instruct'; they are NOT interchangeable
#                     strings even though it's the same underlying model. Requires OPENROUTER_KEY
#                     below. Scout is NOT a reasoning model — no <think> pass, so no token-budget
#                     inflation needed (see OCR_MAX_TOKENS).
# VISION_MODEL_HEAVY: SAME id on purpose — "escalation" = more context/tokens, not a model swap.
# TEXT_MODEL        : llama-3.3-70b-versatile — UNCHANGED, still Groq.
# CLASSIFY_MODEL    : openai/gpt-oss-20b — UNCHANGED, still Groq (ADR-006).
VISION_MODEL=meta-llama/llama-4-scout
VISION_MODEL_HEAVY=meta-llama/llama-4-scout
TEXT_MODEL=llama-3.3-70b-versatile
CLASSIFY_MODEL=openai/gpt-oss-20b

# OPENROUTER_KEY: required for vision OCR (lib/openrouter.js). Get one free at
#   openrouter.ai/keys — the key itself is free, but non-":free"-suffixed models like Scout
#   need a small funded account balance (e.g. $10) to actually run. Cost is negligible at this
#   account's volume: $0.10/$0.30 per million input/output tokens ≈ $0.0005-0.001/receipt.
OPENROUTER_KEY=

# ── OCR extraction tuning (lib/ocr.js) ──────────────────────────────────────
# OCR_MAX_TOKENS      : token budget for one vision extraction. Default 900 (the original
#                       pre-qwen value) — Scout has no <think> reasoning pass to budget for.
# OCR_EMPTY_RETRIES   : retry an extraction this many times when it returns TOTALLY empty
#                       (truncation / non-JSON). Default 1 (→ up to 2 attempts). Originally
#                       added for qwen's <think>-spiral failure mode; kept as a cheap generic
#                       safety net for any stray empty/malformed reply. 0 disables. Separate
#                       from orChat's own 429/network backoff.
# OCR_MAX_TOKENS=900
# OCR_EMPTY_RETRIES=1

# ── Business data-privacy posture (ADR-021 Phase 5) ─────────────────────────
# A paying business's receipts are sensitive.
#   Groq ZDR (Zero Data Retention): enable ZDR on the Groq account/org that owns the key(s)
#   in GROQ_KEY / GROQ_KEYS (still used for TEXT_MODEL/CLASSIFY_MODEL/AGENT_MODEL) — a Groq
#   Console/account setting, applied per request automatically once on. Nothing to set here;
#   this line is the reminder to turn it on for any business/multi-user deployment
#   (CAP_MULTI_USER=true). OpenRouter has its own data-retention settings at openrouter.ai/settings
#   if the same posture is needed for vision/OCR traffic.

# ── Currency conversion (#10 — FX API, NOT the LLM) ─────────────────────────
# Choose a provider in PROJECT_BRIEF §10. Frankfurter needs no key.
FX_API_URL=https://api.frankfurter.app
FX_API_KEY=
FX_CACHE_HOURS=24

# ── Privacy / retention (ADR-002) ───────────────────────────────────────────
# Days to keep raw receipt images / ai_raw before cleanup. 0 = keep (set a real value before launch).
RETENTION_DAYS=0

# ── Dashboard agent (#9 — native tool-calling; qwen verified for function-calling) ──
# AGENT_MODEL      : Groq model id used for the chat/tool-calling loop.
# AGENT_MAX_TOKENS : max_tokens per chat call in the agent loop.
AGENT_MODEL=qwen/qwen3.6-27b
AGENT_MAX_TOKENS=1500

# ── Mass upload (#7) ─────────────────────────────────────────────────────────
# MASS_MAX_IMAGES : max PDF pages per document, max photos per dashboard bulk upload
# (POST /api/upload), AND max photos per Telegram media-group batch (lib/bot.js's
# MAX_GROUP_IMAGES). One shared cap across all three, same as before the qwen model era.
MASS_MAX_IMAGES=10

# 2026-07-21 (post-qwen model switch, PR #296): the Telegram photo-batch cap was briefly
# lowered to 2 and hardcoded (2026-07-20/21) as a qwen-only rate-limit workaround — qwen's
# per-key budget couldn't reliably handle 3+ receipts in one batch. Vision OCR now runs on
# OpenRouter/Scout, not qwen/Groq, so that ceiling no longer applies here; the cap reverted
# to reading MASS_MAX_IMAGES like the other two uses, default 10.
