# ============================================================================
# Receipt Analyser SaaS — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ── Telegram ────────────────────────────────────────────────────────────────
# Create a new bot with @BotFather → /newbot → paste the token here.
BOT_TOKEN=

# ── Groq (vision OCR + LLM) ─────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
# GROQ_KEYS (optional, ADR-016 multi-key pool): comma-separated keys from several free
#   accounts, e.g. GROQ_KEYS=k1,k2,k3 — the system falls through to a fresh account's quota
#   on a 429 (~Nx daily ceiling at $0, same model/quality). ⚠️ When GROQ_KEYS is set it
#   SUPERSEDES GROQ_KEY — GROQ_KEY is then IGNORED (a stale value here is silently unused,
#   NOT added to the pool). Use one or the other. All keys are server-side-only secrets,
#   rotated per the ADR-015 launch gate. Leave GROQ_KEYS unset to use the single GROQ_KEY.
GROQ_KEY=
GROQ_KEYS=

# ── Supabase (your colleague's project) ─────────────────────────────────────
# SB_URL  = the project URL, e.g. https://abcdxyz.supabase.co  (NO /rest/v1)
# SB_KEY  = the SERVICE-ROLE key (Settings → API). Server-side only — never shipped to the browser.
SB_URL=
SB_KEY=

# ── Public URL (for automatic Telegram webhook registration) ────────────────
# The HTTPS URL where THIS server is reachable, e.g. https://receipts.yourdomain.com
# Leave blank to skip auto-registration and register the webhook manually (see README).
PUBLIC_URL=

# ── Security (optional but recommended) ─────────────────────────────────────
# WEBHOOK_SECRET   : random string; Telegram echoes it back so only Telegram can post to /webhook.
# DASHBOARD_TOKEN  : if set, the dashboard + /api/expenses (+ /receipt/:fileId) require this token.
#                    PRODUCTION MUST SET THIS. When NODE_ENV=production (or AUTH_REQUIRED=true)
#                    and this is unset, checkDash fails CLOSED — every gated route (including the
#                    receipt-image proxy) refuses the request with a 500 "server misconfigured"
#                    rather than silently letting it through. In dev, an unset token still falls
#                    back to the old permissive (no-op) behavior, but logs a console.warn on every
#                    unauthenticated request so it's never silently forgotten.
# AUTH_REQUIRED    : set to "true" to force the fail-closed behavior above outside NODE_ENV=production
#                    (e.g. a staging env). Not needed if NODE_ENV=production is already set.
# DASHBOARD_ORIGIN : the dashboard's own origin (e.g. https://receipts.yourdomain.com, no trailing
#                    slash/path). When set, token-gated routes reflect it as
#                    Access-Control-Allow-Origin instead of '*'. PRODUCTION SHOULD SET THIS — with
#                    a bearer token, '*' lets any origin call the API from a browser. Left unset,
#                    routes fall back to '*' so local dev keeps working without extra config.
WEBHOOK_SECRET=
DASHBOARD_TOKEN=
AUTH_REQUIRED=
DASHBOARD_ORIGIN=

# ── Rate limiting (P6 hardening — lib/ratelimit.js, per-IP fixed window) ────
# These are RUNAWAY backstops, not throttles — set generous so a busy legit user/company
# NEVER trips them; the Groq key pool (ADR-016) is the actual cost backstop. Raise freely.
# DASH_AUTH_RATE_MAX : requests/min per IP that FAIL auth before a 429 (valid-token traffic
#                      bypasses the limiter entirely — review A#1) — blunts DASHBOARD_TOKEN brute-force only.
# UPLOAD_RATE_MAX    : requests/min per IP to POST /api/upload (~10x a human's peak; caps a bug-loop).
# AGENT_RATE_MAX     : requests/min per IP to POST /api/agent (~6-12x a power-user's peak).
# WEBHOOK_RATE_MAX    (Barat's, see routes/webhook.js) : requests/min per IP to POST /webhook.
# READY_RATE_MAX     : requests/min per IP to GET /ready (#13 deep readiness probe; it touches the DB).
DASH_AUTH_RATE_MAX=60
UPLOAD_RATE_MAX=120
AGENT_RATE_MAX=120
READY_RATE_MAX=60

# ── App defaults ────────────────────────────────────────────────────────────
# ACCOUNT_ID       : scope key for v1 (one account). Keep 'default' unless you know why.
# DEFAULT_CURRENCY : used when a receipt doesn't show a currency (USD, AUD, MYR, EUR, GBP, …).
# DEFAULT_TAX_RATE : 0 for none, or e.g. 0.10 for 10% GST (used to split tax-inclusive totals).
# VISION_MODEL     : Groq vision model id.
# PORT             : HTTP port.
# ALLOWED_CHAT_IDS : optional comma-separated Telegram chat IDs allowed to use the bot.
#                    Empty/unset = open to anyone. Set it to lock the bot to known users.
ACCOUNT_ID=default
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0
ALLOWED_CHAT_IDS=

# ── Account capabilities (ADR-010) ──────────────────────────────────────────
# One codebase, capability flags. Default = personal (all business features OFF).
# ACCOUNT_TYPE=business flips the defaults on; individual CAP_* override either way.
# ACCOUNT_TYPE           : personal | business   (default personal)
# CAP_BUSINESS_PROFILE   : business-context categorization + personal-expense detection (#5/#6)
# CAP_CLAIMS_TAX         : surface reclaimable VAT/GST in reports/dashboard
# CAP_BANK_RECONCILIATION: receipt <-> bank-statement matching
# CAP_MULTI_USER         : roles + admin approve/reject queue
# BUSINESS_TYPE          : e.g. "restaurant" — context for the personal-vs-business check
ACCOUNT_TYPE=personal
# CAP_BUSINESS_PROFILE=
# CAP_CLAIMS_TAX=
# CAP_BANK_RECONCILIATION=
# CAP_MULTI_USER=
# BUSINESS_TYPE=
PORT=3001

# ── Model routing (Vertical AI — see docs/ARCHITECTURE.md §3.5) ──────────────
# Verified live by Barat 2026-07-01 with real base64-image round-trips (HTTP 200).
# See docs/DECISIONS.md ADR-007 for full status + rationale.
#
# VISION_MODEL      : qwen/qwen3.6-27b — the ONLY Production vision model on the account.
#                     Images + tool use + JSON mode; 131K ctx; up to 5 images/req.
#                     NOTE: runs a "thinking" pass (<think>…) — give OCR a generous max_tokens
#                     or disable thinking, else short replies get eaten by reasoning tokens.
# VISION_MODEL_HEAVY: SAME id on purpose. Maverick is decommissioned; the only other vision
#                     model (meta-llama/llama-4-scout-17b-16e-instruct) is alive but PREVIEW-only
#                     ("not for production"), so it's intentionally kept OUT of the prod path.
#                     "Escalation" = same model w/ higher max_tokens / more context, not a swap.
#                     Swap this to scout ONLY if Groq graduates it to Production (log in WORKLOG).
# TEXT_MODEL        : llama-3.3-70b-versatile  — Production ✅
# CLASSIFY_MODEL    : openai/gpt-oss-20b        — Production ✅ (ADR-006)
VISION_MODEL=qwen/qwen3.6-27b
VISION_MODEL_HEAVY=qwen/qwen3.6-27b
TEXT_MODEL=llama-3.3-70b-versatile
CLASSIFY_MODEL=openai/gpt-oss-20b

# ── Business data-privacy posture (ADR-021 Phase 5) ─────────────────────────
# A paying business's receipts are sensitive. Two ops levers, no code change needed:
#   1. Groq ZDR (Zero Data Retention): enable ZDR on the Groq account/org that owns the
#      key(s) in GROQ_KEY / GROQ_KEYS — a Groq Console/account setting, applied per
#      request automatically once on. Nothing to set here; this line is the reminder to
#      turn it on for any business/multi-user deployment (CAP_MULTI_USER=true).
#   2. OCR provider knob: OCR runs against the Groq-hosted VISION_MODEL above. To move OCR
#      to a different provider/endpoint under a stricter data-handling agreement, point the
#      base URL below at that provider's OpenAI-compatible /chat/completions and set its key.
#      Unset = the default Groq endpoint (today's behaviour), unchanged for personal use.
# OCR_API_BASE_URL=
# OCR_API_KEY=

# ── Currency conversion (#10 — FX API, NOT the LLM) ─────────────────────────
# Choose a provider in PROJECT_BRIEF §10. Frankfurter needs no key.
FX_API_URL=https://api.frankfurter.app
FX_API_KEY=
FX_CACHE_HOURS=24

# ── Privacy / retention (ADR-002) ───────────────────────────────────────────
# Days to keep raw receipt images / ai_raw before cleanup. 0 = keep (set a real value before launch).
RETENTION_DAYS=0

# ── Dashboard agent (#9 — native tool-calling; qwen verified for function-calling) ──
# AGENT_MODEL      : Groq model id used for the chat/tool-calling loop.
# AGENT_MAX_TOKENS : max_tokens per chat call in the agent loop.
AGENT_MODEL=qwen/qwen3.6-27b
AGENT_MAX_TOKENS=1500

# ── Mass upload (#7) ─────────────────────────────────────────────────────────
# MASS_MAX_IMAGES : max photos accepted per dashboard batch (POST /api/upload).
MASS_MAX_IMAGES=10
