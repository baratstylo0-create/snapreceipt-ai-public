# ============================================================================
# Receipt Analyser SaaS — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ── Telegram ────────────────────────────────────────────────────────────────
# Create a new bot with @BotFather → /newbot → paste the token here.
BOT_TOKEN=

# ── Groq (vision OCR + LLM) ─────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_KEY=

# ── Supabase (your colleague's project) ─────────────────────────────────────
# SB_URL  = the project URL, e.g. https://abcdxyz.supabase.co  (NO /rest/v1)
# SB_KEY  = the SERVICE-ROLE key (Settings → API). Server-side only — never shipped to the browser.
SB_URL=
SB_KEY=

# ── Public URL (for automatic Telegram webhook registration) ────────────────
# The HTTPS URL where THIS server is reachable, e.g. https://receipts.yourdomain.com
# Leave blank to skip auto-registration and register the webhook manually (see README).
PUBLIC_URL=

# ── Security (optional but recommended) ─────────────────────────────────────
# WEBHOOK_SECRET   : random string; Telegram echoes it back so only Telegram can post to /webhook.
# DASHBOARD_TOKEN  : if set, the dashboard + /api/expenses require this token (simple gate for v1).
WEBHOOK_SECRET=
DASHBOARD_TOKEN=

# ── App defaults ────────────────────────────────────────────────────────────
# ACCOUNT_ID       : scope key for v1 (one account). Keep 'default' unless you know why.
# DEFAULT_CURRENCY : used when a receipt doesn't show a currency (USD, AUD, MYR, EUR, GBP, …).
# DEFAULT_TAX_RATE : 0 for none, or e.g. 0.10 for 10% GST (used to split tax-inclusive totals).
# VISION_MODEL     : Groq vision model id.
# PORT             : HTTP port.
ACCOUNT_ID=default
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0
PORT=3001

# ── Model routing (Vertical AI — see docs/ARCHITECTURE.md §3.5) ──────────────
# Verified live by Barat 2026-07-01 against console.groq.com/docs/models.
# See docs/DECISIONS.md ADR-007 for full status + rationale.
#
# VISION_MODEL      : qwen/qwen3.6-27b   — Production vision (replaces llama-4-scout which is Preview-only).
#                     Supports images + tool use + JSON mode; 131K ctx; up to 5 images/req.
# VISION_MODEL_HEAVY: same model used as escalation path until a heavier production vision model ships.
#                     Monitor console.groq.com for a production llama-4-maverick replacement.
# TEXT_MODEL        : llama-3.3-70b-versatile  — Production ✅
# CLASSIFY_MODEL    : openai/gpt-oss-20b        — Production ✅ (ADR-006)
VISION_MODEL=qwen/qwen3.6-27b
VISION_MODEL_HEAVY=qwen/qwen3.6-27b
TEXT_MODEL=llama-3.3-70b-versatile
CLASSIFY_MODEL=openai/gpt-oss-20b

# ── Currency conversion (#10 — FX API, NOT the LLM) ─────────────────────────
# Choose a provider in PROJECT_BRIEF §10. Frankfurter needs no key.
FX_API_URL=https://api.frankfurter.app
FX_API_KEY=
FX_CACHE_HOURS=24

# ── Privacy / retention (ADR-002) ───────────────────────────────────────────
# Days to keep raw receipt images / ai_raw before cleanup. 0 = keep (set a real value before launch).
RETENTION_DAYS=0
